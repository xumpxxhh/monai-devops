{
  "id": "ci-pipeline-poc",
  "name": "CI Pipeline PoC",
  "steps": [
    {
      "id": "checkout",
      "name": "Checkout",
      "plugin": "git-checkout-plugin",
      "config": {
        "repoUrl": "https://github.com/xumpxxhh/monai-devops.git",
        "ref": "main"
      }
    },
    {
      "id": "inject-env",
      "name": "Inject env files",
      "plugin": "file-inject-plugin",
      "dependsOn": ["checkout"],
      "config": {
        "files": [
          {
            "path": "apps/server/.env",
            "content": "GLOBAL_API_PREFIX=api/v1/devops\nAPP_ENV=local-dev\nPORT=3000\nMAX_PARALLEL_STEPS=2\nRESOURCE_POOL_SIZE=5\nMAX_ACTIVE_RUNS=50\nRUN_HISTORY_LIMIT=500\nDATABASE_URL=postgresql://monai:monai@host.docker.internal:5432/monai_devops\n"
          }
        ]
      }
    },
    {
      "id": "install",
      "name": "Install",
      "plugin": "shell-exec-plugin",
      "dependsOn": ["inject-env"],
      "config": {
        "command": "pnpm install --frozen-lockfile",
        "timeoutMs": 600000,
        "sandbox": "docker"
      }
    },
    {
      "id": "lint",
      "name": "Lint",
      "plugin": "shell-exec-plugin",
      "dependsOn": ["install"],
      "config": {
        "command": "pnpm lint",
        "timeoutMs": 600000,
        "sandbox": "docker"
      }
    },
    {
      "id": "test",
      "name": "Test",
      "plugin": "shell-exec-plugin",
      "dependsOn": ["install"],
      "config": {
        "command": "pnpm test",
        "timeoutMs": 600000,
        "sandbox": "docker"
      }
    },
    {
      "id": "build",
      "name": "Build",
      "plugin": "shell-exec-plugin",
      "dependsOn": ["lint", "test"],
      "config": {
        "command": "pnpm build",
        "timeoutMs": 600000,
        "sandbox": "docker"
      }
    }
  ]
}
