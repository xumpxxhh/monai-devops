# 测试 / `pnpm dev:test` 专用环境（可提交；无密钥）
# Jest 与 e2e 共用；DATABASE_URL 必须指向 monai_devops_test（团队公共实例，见 docs/ops/postgres-shared.md）

GLOBAL_API_PREFIX=api/v1/devops
APP_ENV=local-test
PORT=3000
MAX_PARALLEL_STEPS=2
RESOURCE_POOL_SIZE=5
MAX_ACTIVE_RUNS=50
RUN_HISTORY_LIMIT=500
DATABASE_URL=postgresql://monai:monai@localhost:5432/monai_devops_test
