# 复制为 .env 或 .env.local 后按需修改（已存在的系统环境变量不会被覆盖）

# [必填] 全局 API 前缀，影响 HTTP / WebSocket 路径，例如 api → /api/...
GLOBAL_API_PREFIX=api

# [可选] HTTP 监听端口，默认 3000
PORT=3000

# [可选] 单个 workflow 内默认并行步骤上限，默认 2
MAX_PARALLEL_STEPS=2

# [可选] 引擎默认资源池容量，默认 5
RESOURCE_POOL_SIZE=5

# [可选] 同时活跃的 Run 上限（queued/running/pausing/paused），超出返回 429，默认 50
MAX_ACTIVE_RUNS=50

# [可选] 单个 Run 事件条数上限；超限时优先裁剪 plugin:log，默认 500
RUN_HISTORY_LIMIT=500

# [必填] PostgreSQL 连接串；本地可用仓库根目录 docker compose（默认 monai/monai）
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://monai:monai@localhost:5432/monai_devops
