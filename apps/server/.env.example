# 复制为 .env 或 .env.local 后按需修改（已存在的系统环境变量不会被覆盖）
# 日常开发连 monai_devops；测试与 `pnpm dev:test` 使用 .env.test → monai_devops_test

# [必填] 全局 API 前缀，影响 HTTP / WebSocket 路径
# 本应用推荐与前端一致：api/v1/devops（与认证 /api/v1/auth 为兄弟路径）
GLOBAL_API_PREFIX=api/v1/devops

# [可选] 部署环境：local-dev | online-dev | local-test | online-test | production，默认 local-dev
APP_ENV=local-dev

# [可选] HTTP 监听端口，默认 3000
PORT=3000

# [可选] 单个 workflow 内默认并行步骤上限，默认 2
MAX_PARALLEL_STEPS=2

# [可选] 引擎默认资源池容量，默认 5
RESOURCE_POOL_SIZE=5

# [可选] 同时活跃的 Run 上限（queued/running/pausing/paused），超出返回 429，默认 50
MAX_ACTIVE_RUNS=50

# [可选] CI / shell 执行类插件的 Run 级工作区根目录；默认系统临时目录下 monai-ci-runs
# 每个 Run 会在其下创建以 runId 命名的子目录，结束后清理。非隔离环境，勿接入不受信任命令。
# CI_WORKSPACE_ROOT=

# [可选] shell-exec-plugin sandbox=docker 时的默认镜像与网络（步骤 config 可覆盖）
# SANDBOX_DOCKER_IMAGE=node:20-bookworm
# SANDBOX_DOCKER_NETWORK=bridge
# bridge 模式下会自动注入 host.docker.internal → 宿主机，便于容器内连本机 Postgres 等

# [可选] 单个 Run 事件条数上限；超限时优先裁剪 plugin:log，默认 500
RUN_HISTORY_LIMIT=500

# [必填] PostgreSQL 连接串（团队公共实例；库名 monai_devops）
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 建库与从旧 compose 迁数据见 docs/ops/postgres-shared.md
DATABASE_URL=postgresql://monai:monai@localhost:5432/monai_devops
# 测试库见 .env.test（monai_devops_test）；勿把手改 .env 当切换方式，请用 pnpm dev:test
