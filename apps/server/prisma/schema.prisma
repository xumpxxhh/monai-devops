generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Run {
  runId            String                    @id @map("run_id")
  workflowId       String                    @map("workflow_id")
  workflowName     String                    @map("workflow_name")
  status           String
  isActive         Boolean                   @default(true) @map("is_active")
  traceId          String?                   @map("trace_id")
  workflowSnapshot Json                      @map("workflow_snapshot")
  countsTotal      Int                       @default(0) @map("counts_total")
  countsCompleted  Int                       @default(0) @map("counts_completed")
  countsFailed     Int                       @default(0) @map("counts_failed")
  countsSkipped    Int                       @default(0) @map("counts_skipped")
  result           Json?
  cancelled        String?
  createdBy        BigInt?                   @map("created_by")
  source           String?                   @default("api")
  metadata         Json                      @default("{}")
  recoveryState    Json?                     @map("recovery_state")
  leaseOwner       String?                   @map("lease_owner")
  leaseToken       String?                   @map("lease_token")
  leaseExpiresAt   DateTime?                 @map("lease_expires_at")
  leaseHeartbeatAt DateTime?                 @map("lease_heartbeat_at")
  parentRunId      String?                   @map("parent_run_id")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  startedAt        DateTime?                 @map("started_at")
  finishedAt       DateTime?                 @map("finished_at")
  events           RunEvent[]
  executionJobs    ExecutionJob[]
  controlCommands  ExecutionControlCommand[]

  @@index([isActive, createdAt])
  @@index([isActive, leaseExpiresAt])
  @@index([workflowId])
  @@index([workflowName])
  @@index([parentRunId])
  @@map("runs")
}

model ExecutionControlCommand {
  commandId   String    @id @map("command_id")
  runId       String    @map("run_id")
  type        String
  payload     Json      @default("{}")
  status      String    @default("pending")
  claimedBy   String?   @map("claimed_by")
  claimedAt   DateTime? @map("claimed_at")
  completedAt DateTime? @map("completed_at")
  error       String?
  requestedAt DateTime  @default(now()) @map("requested_at")
  run         Run       @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([runId, requestedAt])
  @@map("execution_control_commands")
}

model ExecutionJob {
  jobId          String             @id @map("job_id")
  runId          String             @map("run_id")
  stepId         String             @map("step_id")
  status         String
  idempotencyKey String?            @map("idempotency_key")
  retryPolicy    Json?              @map("retry_policy")
  checkpoint     Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  run            Run                @relation(fields: [runId], references: [runId], onDelete: Cascade)
  attempts       ExecutionAttempt[]

  @@unique([runId, stepId])
  @@unique([runId, idempotencyKey])
  @@index([runId, status])
  @@map("execution_jobs")
}

model ExecutionAttempt {
  attemptId      String       @id @map("attempt_id")
  jobId          String       @map("job_id")
  attempt        Int
  status         String
  leaseOwner     String?      @map("lease_owner")
  leaseToken     String?      @map("lease_token")
  leaseExpiresAt DateTime?    @map("lease_expires_at")
  heartbeatAt    DateTime?    @map("heartbeat_at")
  messageSequence Int          @default(0) @map("message_sequence")
  reason         Json?
  result         Json?
  waitKind       String?      @map("wait_kind")
  wakeKey        String?      @map("wake_key")
  wakeAt         DateTime?    @map("wake_at")
  waitTimeoutAt  DateTime?    @map("wait_timeout_at")
  wakeReadyAt    DateTime?    @map("wake_ready_at")
  wakePayload    Json?        @map("wake_payload")
  createdAt      DateTime     @default(now()) @map("created_at")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  job            ExecutionJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  workerMessages ExecutionAttemptMessage[]

  @@unique([jobId, attempt])
  @@index([status, leaseExpiresAt])
  @@index([status, wakeAt])
  @@index([status, waitTimeoutAt])
  @@index([wakeKey, status])
  @@map("execution_attempts")
}

model ExecutionAttemptMessage {
  attemptId      String           @map("attempt_id")
  sequence       Int
  kind           String
  eventType      String?          @map("event_type")
  payloadVersion Int?             @map("payload_version")
  payload        Json?
  occurredAt     DateTime         @map("occurred_at")
  receivedAt     DateTime         @default(now()) @map("received_at")
  attempt        ExecutionAttempt @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)

  @@id([attemptId, sequence])
  @@map("execution_attempt_messages")
}

model RunEvent {
  id         BigInt   @id @default(autoincrement())
  runId      String   @map("run_id")
  eventIndex Int      @map("event_index")
  type       String
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")
  run        Run      @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, eventIndex])
  @@map("run_events")
}

model Workflow {
  id              String   @id
  name            String   @unique
  definition      Json
  /**
   * 非空表示私有拷贝，仅所属父工作流可管理，不进公开列表
   */
  ownerWorkflowId String?  @map("owner_workflow_id")
  createdBy       BigInt?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ownerWorkflow Workflow?  @relation("PrivateCopyOwner", fields: [ownerWorkflowId], references: [id], onDelete: Cascade)
  privateCopies Workflow[] @relation("PrivateCopyOwner")

  importsAsParent WorkflowImport[] @relation("ImportsFromParent")
  importsAsChild  WorkflowImport[] @relation("ImportsToChild")

  @@index([ownerWorkflowId])
  @@map("workflows")
}

model WorkflowImport {
  id               String   @id
  parentWorkflowId String   @map("parent_workflow_id")
  childWorkflowId  String   @map("child_workflow_id")
  stepId           String   @default("") @map("step_id")
  mode             String
  createdAt        DateTime @default(now()) @map("created_at")

  parentWorkflow Workflow @relation("ImportsFromParent", fields: [parentWorkflowId], references: [id], onDelete: Cascade)
  childWorkflow  Workflow @relation("ImportsToChild", fields: [childWorkflowId], references: [id], onDelete: Cascade)

  @@index([parentWorkflowId])
  @@index([childWorkflowId])
  @@map("workflow_imports")
}
